  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-alpha(\.[0-9]+){0,2}|-beta(\.[0-9]+)?)?$ ]] || { fastup_resolve_error codex "invalid official release version: $version"; return 1; }
  index=0; url=; digest=
  while :; do
    name="$(printf '%s' "$metadata" | /usr/bin/plutil -extract "assets.$index.name" raw -o - - 2>/dev/null)" || break
    if [ "$name" = "$asset" ]; then
      digest="$(printf '%s' "$metadata" | /usr/bin/plutil -extract "assets.$index.digest" raw -o - - 2>/dev/null)" || { fastup_resolve_error codex "asset $asset has no checksum"; return 1; }
      url="$(printf '%s' "$metadata" | /usr/bin/plutil -extract "assets.$index.browser_download_url" raw -o - - 2>/dev/null)" || { fastup_resolve_error codex "asset $asset has no download URL"; return 1; }
      break
    fi
    index=$((index + 1))
  done
  case "$digest" in sha256:*) digest="${digest#sha256:}" ;; *) fastup_resolve_error codex "release $tag has no checksum for $asset"; return 1 ;; esac
  case "$digest" in
    ????????????????????????????????????????????????????????????????) ;;
