  done
  case "${digest:-}" in sha256:*) digest="${digest#sha256:}" ;; *) fastup_resolve_error self "release $tag has no checksum for fastup"; return 1 ;; esac
  case "$digest" in ????????????????????????????????????????????????????????????????) ;; *) fastup_resolve_error self 'invalid checksum for fastup'; return 1 ;; esac
  case "$digest" in *[!0-9a-f]*) fastup_resolve_error self 'invalid checksum for fastup'; return 1 ;; esac
  [ -n "${url:-}" ] || { fastup_resolve_error self "release $tag has no asset fastup"; return 1; }
  LATEST="${tag#v}"
  CANDIDATES="$(gh_candidates "$url" sha256 "$digest" raw)" || { fastup_resolve_error self 'cannot build candidates for fastup'; return 1; }
}

self_install() {
  local payload="$1" tmp
  [ "$("$BASH" "$payload" --version 2>/dev/null)" = "fastup $LATEST" ] || {
    printf 'self: downloaded script does not report version %s\n' "$LATEST" >&2; return 1;
  }
  tmp="$(mktemp "${SELF_TARGET%/*}/.fastup.XXXXXX")" || { printf 'self: cannot create temp file in %s\n' "${SELF_TARGET%/*}" >&2; return 1; }
  if cp "$payload" "$tmp" && chmod 755 "$tmp" && mv -f "$tmp" "$SELF_TARGET"; then
    printf 'self: updated %s -> %s\n' "$FASTUP_VERSION" "$LATEST"
  else
    rm -f "$tmp"
    printf 'self: cannot replace %s\n' "$SELF_TARGET" >&2
    return 1
  fi
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  fastup_main "$@"
  exit $?
fi
