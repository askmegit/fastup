  [ -x "$CLAUDE_LINK" ] || { fastup_native_unsupported claude "$CLAUDE_LINK is not executable"; return 3; }
}

claude_current() {
  local output
  output="${CLAUDE_LINK:-}"; [ -n "$output" ] || return 1
  output="$("$output" --version 2>/dev/null)" || return 1
  printf '%s\n' "$output" | awk 'NR == 1 { print $1 }'
}

claude_resolve() {
  local channel metadata version manifest platform checksum translated
  channel=latest
  if [ -f "$HOME/.claude/settings.json" ]; then
    channel="$(/usr/bin/plutil -extract autoUpdatesChannel raw -o - "$HOME/.claude/settings.json" 2>/dev/null)" || channel=latest
    [ -n "$channel" ] || channel=latest
  fi
  CLAUDE_BASE="${FASTUP_CLAUDE_BASE:-https://downloads.claude.ai/claude-code-releases}"
  version="$(curl -fsSL "${CLAUDE_BASE%/}/$channel")" || { fastup_resolve_error claude 'cannot fetch official release version'; return 1; }
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { fastup_resolve_error claude "invalid official version: $version"; return 1; }
  case "$(uname -m)" in
    arm64) platform=darwin-arm64 ;;
    x86_64)
      translated="$(sysctl -in sysctl.proc_translated 2>/dev/null)" || translated=0
      if [ "$translated" = 1 ]; then platform=darwin-arm64; else platform=darwin-x64; fi ;;
    *) fastup_resolve_error claude "unsupported architecture $(uname -m)"; return 1 ;;
  esac
  manifest="$(curl -fsSL "${CLAUDE_BASE%/}/$version/manifest.json")" || { fastup_resolve_error claude "cannot fetch official manifest for $version"; return 1; }
  checksum="$(printf '%s' "$manifest" | /usr/bin/plutil -extract "platforms.$platform.checksum" raw -o - - 2>/dev/null)" || { fastup_resolve_error claude "manifest has no checksum for $platform"; return 1; }
  case "$checksum" in
    ????????????????????????????????????????????????????????????????) ;;
    *) fastup_resolve_error claude 'invalid official SHA-256 checksum'; return 1 ;;
  esac
  case "$checksum" in *[!0-9a-f]*) fastup_resolve_error claude 'invalid official SHA-256 checksum'; return 1 ;; esac
  LATEST="$version"
  CLAUDE_CHECKSUM="$checksum"
  CANDIDATES="$(printf '%s\tsha256\t%s\traw\n' "${CLAUDE_BASE%/}/$version/$platform/claude" "$checksum"
    npm_candidates "@anthropic-ai/claude-code-$platform" "$version" tgz:package/claude)" || { fastup_resolve_error claude 'cannot build official release candidates'; return 1; }
}

claude_install() {
  local payload="$1" actual reported new old_target version_file tmp backup tmp_link
  actual="$(fastup_hash_file "$payload" sha256)" || return 1
  [ "$actual" = "${CLAUDE_CHECKSUM:-}" ] || { printf 'claude: payload SHA-256 does not match official manifest\n' >&2; return 1; }
  if [ "$(uname -s)" = Darwin ]; then
    codesign --verify --strict "$payload" || return 1
  fi
  chmod 755 "$payload" || return 1
  reported="$("$payload" --version 2>/dev/null)" || reported=
  new="$(printf '%s\n' "$reported" | awk 'NR == 1 { print $1 }')"
  [ "$new" = "$LATEST" ] || { printf 'claude: downloaded version %s does not match %s\n' "$new" "$LATEST" >&2; return 1; }
  old_target="$(readlink "$CLAUDE_LINK")" || return 1
  version_file="$CLAUDE_VERSIONS_DIR/$LATEST"
  tmp="$CLAUDE_VERSIONS_DIR/.$LATEST.tmp.$$"
  backup="$CLAUDE_VERSIONS_DIR/.$LATEST.backup.$$"
  if ! cp "$payload" "$tmp" || ! chmod 755 "$tmp"; then rm -f "$tmp"; return 1; fi
  if [ -e "$version_file" ]; then
    if [ -L "$version_file" ] || ! ln "$version_file" "$backup"; then rm -f "$tmp"; return 1; fi
  fi
  if ! mv -f "$tmp" "$version_file"; then rm -f "$tmp" "$backup"; return 1; fi
  tmp_link="$(dirname "$CLAUDE_LINK")/.claude.new.$$"
  if ! ln -s "$version_file" "$tmp_link" || ! mv -f "$tmp_link" "$CLAUDE_LINK"; then
    rm -f "$tmp_link" "$version_file"
    [ ! -e "$backup" ] || mv -f "$backup" "$version_file"
    return 1
  fi
  reported="$(claude_current 2>/dev/null)" || reported=
  if [ "$reported" != "$LATEST" ]; then
    tmp_link="$(dirname "$CLAUDE_LINK")/.claude.rollback.$$"
    ln -s "$old_target" "$tmp_link" && mv -f "$tmp_link" "$CLAUDE_LINK"
    if [ -e "$backup" ]; then mv -f "$backup" "$version_file"; else rm -f "$version_file"; fi
    printf 'claude: installed version %s does not match %s; restored previous target\n' "$reported" "$LATEST" >&2
    return 1
  fi
  rm -f "$backup"
  printf 'claude: updated %s -> %s\n' "${current:-unknown}" "$reported"
}


codex_resolve() {
