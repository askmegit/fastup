codex_detect() {
  local current releases resolved
  CODEX_HOME_DIR="${CODEX_HOME:-$HOME/.codex}"
  CODEX_ROOT="$CODEX_HOME_DIR/packages/standalone"
  current="$CODEX_ROOT/current"
  releases="$CODEX_ROOT/releases"
  if [ ! -e "$current" ] && [ ! -L "$current" ] && ! command -v codex >/dev/null 2>&1; then return 4; fi
  [ -L "$current" ] || { fastup_native_unsupported codex "$current is not a standalone release symlink"; return 3; }
  [ -d "$releases" ] || { fastup_native_unsupported codex "$releases is missing"; return 3; }
  resolved="$(cd "$current" 2>/dev/null && pwd -P)" || { fastup_native_unsupported codex "$current cannot be resolved"; return 3; }
  releases="$(cd "$releases" 2>/dev/null && pwd -P)" || { fastup_native_unsupported codex "$releases is unavailable"; return 3; }
  case "$resolved" in "$releases"/*) ;; *) fastup_native_unsupported codex "$current does not resolve into $releases"; return 3 ;; esac
  case "$(uname -m)" in arm64) CODEX_TARGET=aarch64-apple-darwin ;; x86_64) CODEX_TARGET=x86_64-apple-darwin ;; *) fastup_native_unsupported codex "unsupported architecture $(uname -m)"; return 3 ;; esac
  if [ -x "$current/bin/codex" ]; then CODEX_CURRENT_BIN="$current/bin/codex"
  elif [ -x "$current/codex" ]; then CODEX_CURRENT_BIN="$current/codex"
  else fastup_native_unsupported codex "$current has no executable codex binary"; return 3
  fi
}

codex_current() {
  local output
  output="$("${CODEX_CURRENT_BIN:-}" --version 2>/dev/null)" || return 1
  printf '%s\n' "$output" | awk 'END { print $NF }'
}

codex_install_locked() {
  local payload="$1" releases release stage path
  releases="$CODEX_ROOT/releases"
  release="$releases/$LATEST-$CODEX_TARGET"
  stage="$releases/.fastup-stage.$LATEST-$CODEX_TARGET.$$"
  mkdir -p "$releases" || return 1
  mkdir "$stage" || return 1
  if ! cp -R "$payload"/. "$stage"/; then rm -rf "$stage"; return 1; fi
  [ -f "$stage/bin/codex" ] || { rm -rf "$stage"; return 1; }
  for path in bin/codex bin/codex-code-mode-host codex-path/rg; do
    [ ! -e "$stage/$path" ] || chmod 755 "$stage/$path" || { rm -rf "$stage"; return 1; }
  done
  ln -sf bin/codex "$stage/codex" || { rm -rf "$stage"; return 1; }
  # Move an existing copy aside instead of deleting it first, so a failed mv cannot lose a live release.
  if [ -e "$release" ]; then mv "$release" "$release.old.$$" || { rm -rf "$stage"; return 1; }; fi
  if ! mv "$stage" "$release"; then
    rm -rf "$stage"
    [ ! -e "$release.old.$$" ] || mv "$release.old.$$" "$release"
    return 1
  fi
  rm -rf "$release.old.$$"
}

codex_install() {
  local payload="$1" lock_rc update_rc current_real release_real new script release
  release="$CODEX_ROOT/releases/$LATEST-$CODEX_TARGET"
  # Hold the official installer's lock while staging, so a concurrent `codex update` cannot clean up or
  # switch to a half-copied release; release it before running that same installer below.
  if [ -x /usr/bin/lockf ]; then
    script="${BASH_SOURCE[0]}"
    # Absolute, or `source` would search PATH and could load a different installed fastup.
    case "$script" in /*) ;; *) script="$PWD/$script" ;; esac
    # The trap removes this child's stage if it is interrupted mid-copy (on success the stage was renamed).
    /usr/bin/lockf -k "$CODEX_ROOT/install.lock" "$BASH" -c "trap 'rm -rf \"\$CODEX_ROOT/releases/.fastup-stage.\"*\".\$\$\"' EXIT; trap 'exit 130' INT; trap 'exit 143' TERM; source \"\$1\"; CODEX_ROOT=\"\$2\"; LATEST=\"\$3\"; CODEX_TARGET=\"\$4\"; codex_install_locked \"\$5\"" _ "$script" "$CODEX_ROOT" "$LATEST" "$CODEX_TARGET" "$payload"
    lock_rc=$?
  else
    codex_install_locked "$payload"
    lock_rc=$?
  fi
  [ "$lock_rc" -eq 0 ] || return 1
  unset CODEX_RELEASE
  if [ -n "${FASTUP_CODEX_UPDATE_CMD:-}" ]; then
    CODEX_NON_INTERACTIVE=1 CODEX_HOME="$CODEX_HOME_DIR" sh -c "$FASTUP_CODEX_UPDATE_CMD"; update_rc=$?
  elif [ -x "$CODEX_ROOT/current/bin/codex" ]; then
    CODEX_NON_INTERACTIVE=1 CODEX_HOME="$CODEX_HOME_DIR" "$CODEX_ROOT/current/bin/codex" update; update_rc=$?
  elif [ -x "$CODEX_ROOT/current/codex" ]; then
    CODEX_NON_INTERACTIVE=1 CODEX_HOME="$CODEX_HOME_DIR" "$CODEX_ROOT/current/codex" update; update_rc=$?
  else
    update_rc=1
  fi
  current_real="$(cd "$CODEX_ROOT/current" 2>/dev/null && pwd -P)" || current_real=
  release_real="$(cd "$release" 2>/dev/null && pwd -P)" || release_real=
  new="$("$CODEX_ROOT/current/bin/codex" --version 2>/dev/null | awk 'END { print $NF }')" || new=
  if [ "$update_rc" -ne 0 ] || [ "$current_real" != "$release_real" ] || [ "$new" != "$LATEST" ]; then
    printf 'codex: official codex update did not switch to %s\n' "$LATEST" >&2
    return 1
  fi
  printf 'codex: updated %s -> %s\n' "${current:-unknown}" "$new"
}

self_detect() {
