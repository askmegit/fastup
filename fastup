agy_candidates_for() {
  [ "$#" -eq 2 ] || return 2
  local url="$1" digest="$2" rest bucket object encoded prefixes index prefix
  local -a proxy_list
  printf '%s\tsha512\t%s\ttgz:antigravity\n' "$url" "$digest"
  case "$url" in
    https://storage.googleapis.com/*)
      rest="${url#https://storage.googleapis.com/}"
      case "$rest" in */*)
        bucket="${rest%%/*}"
        object="${rest#*/}"
        encoded="${object//\//%2F}"
        printf 'https://www.googleapis.com/download/storage/v1/b/%s/o/%s?alt=media\tsha512\t%s\ttgz:antigravity\n' "$bucket" "$encoded" "$digest"
      esac ;;
  esac
  prefixes="${FASTUP_PROXIES:-}"
  IFS=' ' read -r -a proxy_list <<EOF
$prefixes
EOF
  index=0
  while [ "$index" -lt "${#proxy_list[@]}" ]; do
    prefix="${proxy_list[$index]}"
    [ -n "$prefix" ] && printf '%s%s\tsha512\t%s\ttgz:antigravity\n' "$prefix" "$url" "$digest"
    index=$((index + 1))
  done
  if [ -n "${FASTUP_VIA:-}" ]; then
    printf '%s%s\tsha512\t%s\ttgz:antigravity\n' "$FASTUP_VIA" "$url" "$digest"
  fi
}

agy_resolve() {
  local arch metadata version url digest
