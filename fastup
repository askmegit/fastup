fastup_native_install() {
  local cli="$1" target="$2" payload="$3" directory tmp backup old reported new
  directory="$(dirname "$target")"
  old="$("$target" --version 2>/dev/null)" || old=unknown
  if [ "$cli" = omp ]; then old="${old#omp/}"; fi
  tmp="$(mktemp "$directory/.fastup.XXXXXX")" || return 1
  if ! cp "$payload" "$tmp" || ! chmod 755 "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  backup="$target.fastup-bak"
  # Hard-link the backup so the target path never disappears; the mv below replaces it atomically.
  if ! ln -f "$target" "$backup"; then rm -f "$tmp"; return 1; fi
  if ! mv -f "$tmp" "$target"; then
    rm -f "$tmp" "$backup"
    return 1
  fi
  reported="$("$target" --version 2>/dev/null)" || reported=
  new="$reported"
  if [ "$cli" = omp ]; then new="${reported#omp/}"; fi
  if [ "$new" != "$LATEST" ]; then
    mv -f "$backup" "$target"
    printf '%s: installed version %s does not match %s; rolled back\n' "$cli" "$new" "$LATEST" >&2
    return 1
  fi
  rm -f "$backup"
  printf '%s: updated %s -> %s\n' "$cli" "$old" "$new"
}

omp_install() { fastup_native_install omp "${OMP_TARGET:-}" "$1"; }
agy_install() { fastup_native_install agy "${AGY_TARGET:-}" "$1"; }
fastup_resolve_path() {
  local path="$1" target directory count=0
  while [ -L "$path" ]; do
    count=$((count + 1))
    [ "$count" -le 40 ] || return 1
    directory="$(cd "$(dirname "$path")" 2>/dev/null && pwd -P)" || return 1
    target="$(readlink "$path")" || return 1
    case "$target" in /*) path="$target" ;; *) path="$directory/$target" ;; esac
  done
  directory="$(cd "$(dirname "$path")" 2>/dev/null && pwd -P)" || return 1
  printf '%s/%s\n' "$directory" "${path##*/}"
}

claude_detect() {
  local target versions_dir
  CLAUDE_HOME_DIR="${FASTUP_CLAUDE_HOME:-$HOME/.local}"
  CLAUDE_LINK="$CLAUDE_HOME_DIR/bin/claude"
  CLAUDE_VERSIONS_DIR="$CLAUDE_HOME_DIR/share/claude/versions"
  if [ ! -e "$CLAUDE_LINK" ] && [ ! -L "$CLAUDE_LINK" ] && ! command -v claude >/dev/null 2>&1; then return 4; fi
  [ -L "$CLAUDE_LINK" ] || { fastup_native_unsupported claude "not a native install at $CLAUDE_LINK"; return 3; }
  [ -d "$CLAUDE_VERSIONS_DIR" ] || { fastup_native_unsupported claude "$CLAUDE_VERSIONS_DIR is missing"; return 3; }
  target="$(readlink "$CLAUDE_LINK")" || { fastup_native_unsupported claude "cannot read $CLAUDE_LINK"; return 3; }
  case "$target" in /*) ;; *) target="$(cd "$(dirname "$CLAUDE_LINK")" && pwd -P)/$target" ;; esac
  target="$(fastup_resolve_path "$target")" || { fastup_native_unsupported claude "cannot resolve $CLAUDE_LINK target"; return 3; }
  versions_dir="$(cd "$CLAUDE_VERSIONS_DIR" && pwd -P)" || { fastup_native_unsupported claude "$CLAUDE_VERSIONS_DIR is unavailable"; return 3; }
