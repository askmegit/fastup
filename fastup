  esac
  metadata="$(curl -fsSL "${FASTUP_AGY_MANIFEST:-https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/darwin_$arch.json}")" || { fastup_resolve_error agy 'cannot fetch official release metadata'; return 1; }
  version="$(printf '%s' "$metadata" | /usr/bin/plutil -extract version raw -o - - 2>/dev/null)" || { fastup_resolve_error agy 'official manifest has no version'; return 1; }
  url="$(printf '%s' "$metadata" | /usr/bin/plutil -extract url raw -o - - 2>/dev/null)" || { fastup_resolve_error agy 'official manifest has no asset URL'; return 1; }
  digest="$(printf '%s' "$metadata" | /usr/bin/plutil -extract sha512 raw -o - - 2>/dev/null)" || { fastup_resolve_error agy 'official manifest has no SHA-512 checksum'; return 1; }
  LATEST="$version"
