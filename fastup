#!/usr/bin/env bash
FASTUP_VERSION=0.2.0

fastup_usage() {
  cat <<'USAGE'
Usage: fastup [options] <claude|codex|omp|agy|self|all>...

self updates fastup itself from its latest release (Homebrew installs: use brew upgrade fastup).

Options:
  --check          Report available updates without installing (exit 10 if available)
  --force          Allow reinstalling or downgrading
  --via PREFIX     Use PREFIX for accelerated download candidates
  --dry-run        Show planned updates without installing
  -v               Print probe speeds
  --version        Print the fastup version
  -h, --help       Show this help
USAGE
}

fastup_probe_one() {
  local candidate="$1" bytes="$2" timeout="$3" dir="$4" index="$5"
  local url algo digest format meta rc status content_type total_time start_time
  local headers body count file_size speed lower_type
  IFS=$'\t' read -r url algo digest format <<EOF
$candidate
EOF
  headers="$dir/headers.$index"
  body="$dir/body.$index"
  # A plain pipe (not >(...)) so the body is fully written before it is counted; %{stderr} keeps
  # the write-out stats apart from the body.
  curl -L -r "0-$((bytes - 1))" --max-time "$timeout" -sS -D "$headers" \
    -w '%{stderr}\n%{http_code}|%{content_type}|%{time_total}|%{time_starttransfer}' \
    -o - "$url" 2>"$dir/meta.$index" | head -c "$bytes" >"$body"
  rc=${PIPESTATUS[0]}
  meta="$(tail -n 1 "$dir/meta.$index")"
  IFS='|' read -r status content_type total_time start_time <<EOF
$meta
EOF
  count=0
  [ -f "$body" ] && count="$(wc -c <"$body" | tr -d ' ')"
  file_size="$(tr '[:upper:]' '[:lower:]' <"$headers" 2>/dev/null | awk '
    /^content-range:/ { split($3, p, "/"); gsub("\\r", "", p[2]); if (p[2] ~ /^[0-9]+$/) total=p[2] }
    /^content-length:/ { clen=$2; gsub("\\r", "", clen) }
    END { if (total != "") print total; else if (clen != "") print clen; else print 0 }
  ')"
  [ -n "$file_size" ] || file_size=0
  [ "$file_size" -gt 0 ] 2>/dev/null || file_size="$bytes"
  lower_type="$(printf '%s' "$content_type" | tr '[:upper:]' '[:lower:]')"
  speed=0
  # Valid: a 200/206 non-HTML body that either completed (all requested bytes, or the whole file)
  # or was cut off by the probe timeout after receiving something -- a slow source, not a broken one.
  if { [ "$status" = 200 ] || [ "$status" = 206 ]; } && [ "${lower_type#text/html}" = "$lower_type" ] &&
      { { [ "$rc" -eq 28 ] && [ "$count" -gt 0 ]; } ||
        { { [ "$rc" -eq 0 ] || [ "$rc" -eq 23 ]; } &&
          { [ "$count" -ge "$bytes" ] || [ "$count" -ge "$file_size" ]; }; }; }; then
    speed="$(awk -v n="$count" -v total="$total_time" -v start="$start_time" \
      'BEGIN { elapsed=total-start; if (elapsed <= 0) elapsed=0.001; printf "%.0f", n/elapsed }')"
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$speed" "$index" "$url" "$algo" "$digest" "$format" "$speed" >"$dir/result.$index"
  if [ "${FASTUP_VERBOSE:-0}" = 1 ]; then
    printf 'fastup: %s %s B/s\n' "$url" "$speed" >&2
  fi
}

probe() {
  if [ -n "${FASTUP_VIA:-}" ]; then
    cat
    return 0
  fi
  local bytes timeout parallel state dir line count index batch tab
  local -a candidates pids
  bytes="${FASTUP_PROBE_BYTES:-2097152}"
  timeout="${FASTUP_PROBE_TIMEOUT:-6}"
  parallel="${FASTUP_PROBE_PARALLEL:-3}"
  case "$bytes" in ''|*[!0-9]*|0) bytes=2097152 ;; esac
  case "$timeout" in ''|*[!0-9]*|0) timeout=6 ;; esac
  case "$parallel" in ''|*[!0-9]*|0) parallel=3 ;; esac
  state="${FASTUP_STATE:-$HOME/.cache/fastup}"
  mkdir -p "$state" || return 1
  dir="$(mktemp -d "$state/probe.XXXXXX")" || return 1
  FASTUP_PROBE_DIR="$dir"
  trap 'rm -rf "$FASTUP_PROBE_DIR"; exit 130' INT
  trap 'rm -rf "$FASTUP_PROBE_DIR"; exit 143' TERM
  count=0
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    candidates[count]="$line"
    count=$((count + 1))
  done
  index=0
  while [ "$index" -lt "$count" ]; do
    batch=0
    pids=()
    while [ "$batch" -lt "$parallel" ] && [ "$index" -lt "$count" ]; do
      fastup_probe_one "${candidates[$index]}" "$bytes" "$timeout" "$dir" "$index" &
      pids[batch]=$!
      index=$((index + 1))
      batch=$((batch + 1))
    done
    batch=0
    while [ "$batch" -lt "${#pids[@]}" ]; do
      wait "${pids[$batch]}" || :
      batch=$((batch + 1))
    done
  done
  tab="$(printf '\t')"
  if [ "$count" -gt 0 ]; then
    sort -t "$tab" -k1,1nr -k2,2n "$dir"/result.* | cut -f3-
  fi
  rm -f "$dir"/headers.* "$dir"/body.* "$dir"/meta.* "$dir"/result.*
  rmdir "$dir"
  trap - INT TERM
}

fastup_hash_file() {
  case "$2" in
    sha256) shasum -a 256 "$1" | awk '{print $1}' ;;
    sha512) shasum -a 512 "$1" | awk '{print $1}' ;;
    *) return 1 ;;
  esac
}

fastup_safe_inner_path() {
  case "$1" in
    ''|/*|*..*) return 1 ;;
    *) return 0 ;;
  esac
}

fastup_archive_paths_safe() {
  local archive="$1" members member
  members="$(tar -tzf "$archive")" || return 1
  while IFS= read -r member; do
    [ -n "$member" ] || continue
    case "$member" in /*|..|../*|*/../*|*/..) return 1 ;; esac
  done <<EOF
$members
EOF
}

fastup_symlinks_safe() {
  local root="$1" link target rel parent depth component old_ifs restore_glob=0
  case $- in *f*) ;; *) restore_glob=1; set -f ;; esac
  while IFS= read -r link; do
    target="$(readlink "$link")" || { [ "$restore_glob" -eq 0 ] || set +f; return 1; }
    case "$target" in /*) [ "$restore_glob" -eq 0 ] || set +f; return 1 ;; esac
    rel="${link#"$root"/}"
    parent="${rel%/*}"
    depth=0
    old_ifs="$IFS"
    IFS=/
    for component in $parent; do
      case "$component" in ''|.) ;; ..) depth=$((depth - 1)) ;; *) depth=$((depth + 1)) ;; esac
    done
    for component in $target; do
      case "$component" in ''|.) ;; ..) depth=$((depth - 1)) ;; *) depth=$((depth + 1)) ;; esac
      [ "$depth" -ge 0 ] || { IFS="$old_ifs"; [ "$restore_glob" -eq 0 ] || set +f; return 1; }
    done
    IFS="$old_ifs"
  done < <(find "$root" -type l -print)
  [ "$restore_glob" -eq 0 ] || set +f
  return 0
}

fetch_verified() {
  [ "$#" -eq 1 ] || return 2
  local outdir state partial_dir partial url algo digest format speed actual stall min_speed inner payload extract_dir
  local out_abs candidate_seen
  outdir="$1"
  mkdir -p "$outdir" || return 1
  out_abs="$(cd "$outdir" && pwd -P)" || return 1
  state="${FASTUP_STATE:-$HOME/.cache/fastup}"
  partial_dir="$state/partial"
  mkdir -p "$partial_dir" || return 1
  candidate_seen=0
  while IFS=$'\t' read -r url algo digest format speed || [ -n "$url$algo$digest$format$speed" ]; do
    [ -n "$url" ] || continue
    candidate_seen=1
    case "$algo" in sha256|sha512) ;; *) printf 'fastup: unsupported checksum algorithm\n' >&2; return 1 ;; esac
    case "$algo:$digest" in
      sha256:????????????????????????????????????????????????????????????????|sha512:????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????) ;;
      *) printf 'fastup: invalid checksum digest\n' >&2; return 1 ;;
    esac
    case "$digest" in *[!0-9a-f]*) printf 'fastup: invalid checksum digest\n' >&2; return 1 ;; esac
    case "$format" in
      raw) inner= ;;
      tgz:*) inner="${format#tgz:}"; fastup_safe_inner_path "$inner" || { printf 'fastup: unsafe archive payload path\n' >&2; return 1; } ;;
      *) printf 'fastup: unsupported candidate format\n' >&2; return 1 ;;
    esac
    partial="$partial_dir/$digest"
    case "$speed" in ''|*[!0-9]*) speed=0 ;; esac
    stall="${FASTUP_STALL_TIME:-30}"
    case "$stall" in ''|*[!0-9]*|0) stall=30 ;; esac
    min_speed=$((speed / 4))
    [ "$min_speed" -ge 1024 ] || min_speed=1024
    # A complete partial left by an earlier run would make `curl -C -` fail with 416, so check it first.
    max_bytes="${FASTUP_MAX_BYTES:-1073741824}"
    if { [ -f "$partial" ] && [ "$(fastup_hash_file "$partial" "$algo")" = "$digest" ]; } ||
      curl -fL -C - --max-filesize "$max_bytes" --speed-limit "$min_speed" --speed-time "$stall" -o "$partial" "$url"; then
      actual="$(fastup_hash_file "$partial" "$algo")" || actual=
      if [ "$actual" != "$digest" ]; then
        printf 'fastup: checksum mismatch for %s\n' "$url" >&2
        rm -f "$partial"
        continue
      fi
      if [ "$format" = raw ]; then
        payload="$(mktemp "$out_abs/.fastup.XXXXXX")" || return 1
        if ! cp "$partial" "$payload" || ! chmod 755 "$payload"; then
          rm -f "$payload"
          return 1
        fi
        rm -f "$partial"
        printf '%s\n' "$payload"
        return 0
      fi
      if ! fastup_archive_paths_safe "$partial"; then
        printf 'fastup: unsafe archive member path\n' >&2
        continue
      fi
      extract_dir="$(mktemp -d "$out_abs/.fastup.XXXXXX")" || return 1
      if ! tar -xzf "$partial" -C "$extract_dir" || ! fastup_symlinks_safe "$extract_dir"; then
        printf 'fastup: unsafe or invalid archive\n' >&2
        rm -rf "$extract_dir"
        continue
      fi
      payload="$extract_dir/$inner"
      if [ ! -e "$payload" ] && [ ! -L "$payload" ]; then
        printf 'fastup: archive payload not found\n' >&2
        rm -rf "$extract_dir"
        continue
      fi
      rm -f "$partial"
      printf '%s\n' "$payload"
      return 0
    fi
  done
  if [ "$candidate_seen" -eq 0 ]; then
    printf 'fastup: no download candidates\n' >&2
  fi
  return 1
}

gh_candidates() {
  [ "$#" -eq 4 ] || return 2
  local url="$1" algo="$2" digest="$3" format="$4" prefixes prefix index
  if [ -n "${FASTUP_VIA:-}" ]; then
    printf '%s\t%s\t%s\t%s\n' "${FASTUP_VIA}${url}" "$algo" "$digest" "$format"
    printf '%s\t%s\t%s\t%s\n' "$url" "$algo" "$digest" "$format"
    return 0
  fi
  printf '%s\t%s\t%s\t%s\n' "$url" "$algo" "$digest" "$format"
  if [ "${FASTUP_GH_PROXIES+x}" = x ]; then
    prefixes="$FASTUP_GH_PROXIES"
  else
    prefixes='https://gh-proxy.com/ https://ghfast.top/ https://gh.llkk.cc/ https://ghproxy.net/'
  fi
  local -a proxy_list
  IFS=' ' read -r -a proxy_list <<EOF
$prefixes
EOF
  index=0
  while [ "$index" -lt "${#proxy_list[@]}" ]; do
    prefix="${proxy_list[$index]}"
    [ -n "$prefix" ] && printf '%s\t%s\t%s\t%s\n' "${prefix}${url}" "$algo" "$digest" "$format"
    index=$((index + 1))
  done
}

npm_candidates() {
  [ "$#" -eq 3 ] || return 2
  local pkg="$1" version="$2" format="$3" registry metadata tarball integrity encoded digest path mirrors mirror index
  registry="${FASTUP_NPM_REGISTRY:-https://registry.npmjs.org}"
  registry="${registry%/}"
  metadata="$(curl -fsSL "$registry/$pkg/$version" 2>/dev/null)" || return 0
  tarball="$(printf '%s' "$metadata" | /usr/bin/plutil -extract dist.tarball raw -o - - 2>/dev/null)" || return 0
  integrity="$(printf '%s' "$metadata" | /usr/bin/plutil -extract dist.integrity raw -o - - 2>/dev/null)" || return 0
  case "$integrity" in sha512-*) encoded="${integrity#sha512-}" ;; *) return 0 ;; esac
  digest="$(printf '%s' "$encoded" | openssl base64 -d -A 2>/dev/null | od -An -tx1 | tr -d ' \n')"
  [ "${#digest}" -eq 128 ] || return 0
  case "$tarball" in "$registry"/*) path="${tarball#"$registry"}" ;; *) return 0 ;; esac
  printf '%s\tsha512\t%s\t%s\n' "$tarball" "$digest" "$format"
  if [ "${FASTUP_NPM_MIRRORS+x}" = x ]; then
    mirrors="$FASTUP_NPM_MIRRORS"
  else
    mirrors='https://registry.npmmirror.com'
  fi
  local -a mirror_list
  IFS=' ' read -r -a mirror_list <<EOF
$mirrors
EOF
  index=0
  while [ "$index" -lt "${#mirror_list[@]}" ]; do
    mirror="${mirror_list[$index]}"
    mirror="${mirror%/}"
    [ -n "$mirror" ] && printf '%s\tsha512\t%s\t%s\n' "${mirror}${path}" "$digest" "$format"
    index=$((index + 1))
  done
  return 0
}

lock_acquire() {
  [ "$#" -eq 1 ] || return 2
  local state lock pid started owner_start stale
  state="${FASTUP_STATE:-$HOME/.cache/fastup}"
  lock="$state/locks/$1"
  mkdir -p "$(dirname "$lock")" || return 1
  while ! mkdir "$lock" 2>/dev/null; do
    pid="$(cat "$lock/pid" 2>/dev/null)"
    started="$(cat "$lock/start" 2>/dev/null)"
    if [ -z "$pid" ] || [ -z "$started" ]; then
      find "$lock" -maxdepth 0 -mmin -1 | grep -q . && return 1
    else
      owner_start="$(LC_ALL=C ps -o lstart= -p "$pid" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      [ -n "$owner_start" ] && [ "$owner_start" = "$started" ] && return 1
    fi
    stale="$lock.stale.$$"
    [ -e "$stale" ] && stale="$lock.stale.$$.${RANDOM:-0}"
    mv "$lock" "$stale" 2>/dev/null || continue
    rm -rf "$stale"
  done
  printf '%s\n' "$$" >"$lock/pid"
  LC_ALL=C ps -o lstart= -p "$$" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' >"$lock/start"
}

lock_release() {
  [ "$#" -eq 1 ] || return 2
  local state lock pid started current_start
  state="${FASTUP_STATE:-$HOME/.cache/fastup}"
  lock="$state/locks/$1"
  pid="$(cat "$lock/pid" 2>/dev/null)"
  started="$(cat "$lock/start" 2>/dev/null)"
  current_start="$(LC_ALL=C ps -o lstart= -p "$$" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  [ "$pid" = "$$" ] && [ "$started" = "$current_start" ] || return 1
  rm -f "$lock/pid" "$lock/start" && rmdir "$lock"
}

fastup_version_gt() {
  local left="$1" right="$2"
  awk -v a="$left" -v b="$right" 'BEGIN {
    sub(/^[vV]/, "", a); sub(/^[vV]/, "", b)
    split(a, av, /-/); split(b, bv, /-/)
    split(av[1], aa, /[.]/); split(bv[1], bb, /[.]/)
    for (i=1; i<=3; i++) {
      x=aa[i]+0; y=bb[i]+0
      if (x>y) exit 0
      if (x<y) exit 1
    }
    if (av[2] == "" && bv[2] != "") exit 0
    if (av[2] != "" && bv[2] == "") exit 1
    if (av[2] == "" && bv[2] == "") exit 1
    an=split(av[2], ap, /[.]/); bn=split(bv[2], bp, /[.]/)
    for (i=1; i<=an && i<=bn; i++) {
      if (ap[i] ~ /^[0-9]+$/ && bp[i] ~ /^[0-9]+$/) {
        x=ap[i]+0; y=bp[i]+0
      } else if (ap[i] ~ /^[0-9]+$/) exit 1
      else if (bp[i] ~ /^[0-9]+$/) exit 0
      else { x=ap[i]; y=bp[i] }
      if (x>y) exit 0
      if (x<y) exit 1
    }
    if (an>bn) exit 0
    exit 1
  }'
}

fastup_cleanup_update() {
  [ -z "${FASTUP_CLEANUP_WORK:-}" ] || rm -rf "$FASTUP_CLEANUP_WORK"
  [ -z "${FASTUP_CLEANUP_LOCK:-}" ] || lock_release "$FASTUP_CLEANUP_LOCK"
  FASTUP_CLEANUP_WORK=
  FASTUP_CLEANUP_LOCK=
}

fastup_update_done() {
  local rc="$1"
  fastup_cleanup_update
  trap - INT TERM EXIT
  return "$rc"
}

fastup_update_one() {
  local cli="$1" current rc payload work
  local detect_fn="${cli}_detect" current_fn="${cli}_current" resolve_fn="${cli}_resolve" install_fn="${cli}_install"
  if ! command -v "$detect_fn" >/dev/null 2>&1 || ! command -v "$current_fn" >/dev/null 2>&1 ||
      ! command -v "$resolve_fn" >/dev/null 2>&1 || ! command -v "$install_fn" >/dev/null 2>&1; then
    printf '%s: not implemented yet\n' "$cli" >&2
    return 1
  fi
  lock_acquire "$cli" || { printf '%s: update lock is held\n' "$cli" >&2; return 1; }
  FASTUP_CLEANUP_WORK=
  FASTUP_CLEANUP_LOCK="$cli"
  trap 'fastup_cleanup_update; exit 130' INT
  trap 'fastup_cleanup_update; exit 143' TERM
  trap 'fastup_cleanup_update' EXIT
  "$detect_fn" || { rc=$?; fastup_update_done "$rc"; return "$rc"; }
  current="$("$current_fn" 2>/dev/null)" || {
    if [ "${FASTUP_FORCE:-0}" = 1 ]; then current=unknown
    else printf '%s: cannot read current version\n' "$cli" >&2; fastup_update_done 1; return 1; fi
  }
  LATEST=
  CANDIDATES=
  "$resolve_fn" || { fastup_update_done 1; return 1; }
  if [ -z "${LATEST:-}" ]; then
    printf '%s: official latest version unavailable\n' "$cli" >&2
    fastup_update_done 1
    return 1
  fi
  if [ "${FASTUP_FORCE:-0}" != 1 ] && { [ "$current" = "$LATEST" ] || fastup_version_gt "$current" "$LATEST"; }; then
    printf '%s: already current (%s)\n' "$cli" "$current"
    fastup_update_done 0
    return 0
  fi
  if [ "${FASTUP_CHECK:-0}" = 1 ]; then
    printf '%s: update available (%s -> %s)\n' "$cli" "$current" "$LATEST"
    fastup_update_done 10
    return 10
  fi
  if [ "${FASTUP_DRY_RUN:-0}" = 1 ]; then
    printf '%s: would update %s -> %s\n' "$cli" "$current" "$LATEST"
    fastup_update_done 0
    return 0
  fi
  # The payload (a copy of the whole download) lives only for this run.
  if ! mkdir -p "${FASTUP_STATE:-$HOME/.cache/fastup}" ||
    ! work="$(mktemp -d "${FASTUP_STATE:-$HOME/.cache/fastup}/payload.XXXXXX")"; then
    fastup_update_done 1
    return 1
  fi
  FASTUP_CLEANUP_WORK="$work"
  payload="$(printf '%s\n' "${CANDIDATES:-}" | probe | fetch_verified "$work")" || {
    fastup_update_done 1
    return 1
  }
  "$install_fn" "$payload"
  rc=$?
  fastup_update_done "$rc"
  return "$rc"
}

# Exit-code precedence across CLIs: 1 (failure) > 3 (unsupported) > 10 (update available) > 0.
fastup_record_rc() {
  case "$2" in
    1) max_rc=1 ;;
    3) [ "$max_rc" -eq 1 ] || max_rc=3 ;;
    10) [ "$max_rc" -eq 0 ] && max_rc=10 ;;
    *) [ "$2" -eq 0 ] || max_rc=1 ;;
  esac
}

fastup_main() {
  local check=0 force=0 dry=0 verbose=0 via='' cli rc max_rc=0 name
  local -a names
  local self_last=0
  names=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --help|-h) fastup_usage; return 0 ;;
      --version) printf 'fastup %s\n' "$FASTUP_VERSION"; return 0 ;;
      --check) check=1 ;;
      --force) force=1 ;;
      --dry-run) dry=1 ;;
      -v) verbose=1 ;;
      --via)
        shift
        if [ "$#" -eq 0 ] || [ -z "$1" ]; then fastup_usage >&2; return 2; fi
        via="$1"
        ;;
      --via=*) via="${1#--via=}"; [ -n "$via" ] || { fastup_usage >&2; return 2; } ;;
      --*) fastup_usage >&2; return 2 ;;
      -*) fastup_usage >&2; return 2 ;;
      self) self_last=1 ;;
      claude|codex|omp|agy|all) names[${#names[@]}]="$1" ;;
      *) fastup_usage >&2; return 2 ;;
    esac
    shift
  done
  [ "${#names[@]}" -gt 0 ] || [ "$self_last" = 1 ] || { fastup_usage >&2; return 2; }
  [ "$check" -eq 0 ] || FASTUP_CHECK=1
  [ "$force" -eq 0 ] || FASTUP_FORCE=1
  [ "$dry" -eq 0 ] || FASTUP_DRY_RUN=1
  [ "$verbose" -eq 0 ] || FASTUP_VERBOSE=1
  [ -z "$via" ] || FASTUP_VIA="$via"
  # self runs last: it replaces this script, and later CLIs (codex re-sources it) must not see a newer copy.
  for name in "${names[@]}" self; do
    if [ "$name" = self ]; then
      [ "$self_last" = 1 ] || continue
      self_last=0
    fi
    if [ "$name" = all ]; then
      for cli in claude codex omp agy; do
        fastup_update_one "$cli"
        rc=$?
        # Providers return 4 for "not installed": skipped under `all`, an error when named explicitly.
        if [ "$rc" -eq 4 ]; then printf '%s: not installed, skipped\n' "$cli"; rc=0; fi
        fastup_record_rc "$cli" "$rc"
      done
    else
      fastup_update_one "$name"
      rc=$?
      if [ "$rc" -eq 4 ]; then printf '%s: not installed\n' "$name" >&2; rc=3; fi
      fastup_record_rc "$name" "$rc"
    fi
  done
  return "$max_rc"
}

fastup_native_unsupported() {
  printf '%s: unsupported install layout: %s; update it with the tool that installed it\n' "$1" "$2" >&2
  return 3
}

fastup_native_detect() {
  local cli="$1" target directory resolved magic
  target="$(command -v "$cli" 2>/dev/null)"
  [ -n "$target" ] || return 4
  [ -f "$target" ] && [ ! -L "$target" ] || {
    fastup_native_unsupported "$cli" "$target is not a regular file"; return 3;
  }
  directory="$(dirname "$target")"
  [ -w "$directory" ] || {
    fastup_native_unsupported "$cli" "$directory is not writable"; return 3;
  }
  resolved="$(cd "$directory" 2>/dev/null && pwd -P)/${target##*/}" || {
    fastup_native_unsupported "$cli" "cannot resolve $target"; return 3;
  }
  case "$resolved" in
    /opt/homebrew/*|/usr/local/Cellar/*|*/node_modules/*|*/.bun/*)
      fastup_native_unsupported "$cli" "$resolved is managed by another installer"; return 3 ;;
  esac
  magic="$(od -An -tx1 -N4 "$target" | tr -d ' \n')"
  case "$magic" in cffaedfe|cefaedfe|cafebabe) ;; *)
    fastup_native_unsupported "$cli" "$target is not a Mach-O binary"; return 3 ;;
  esac
  case "$cli" in omp) OMP_TARGET="$target" ;; agy) AGY_TARGET="$target" ;; esac
}

omp_detect() { fastup_native_detect omp; }

omp_current() {
  local output
  output="$("${OMP_TARGET:-}" --version 2>/dev/null)" || return 1
  case "$output" in omp/*) printf '%s\n' "${output#omp/}" ;; *) return 1 ;; esac
}

fastup_resolve_error() {
  printf '%s: %s\n' "$1" "$2" >&2
  return 1
}

omp_resolve() {
  local api metadata tag asset digest url index name
  local api_host
  case "$(uname -m)" in
    arm64) asset=omp-darwin-arm64 ;;
    x86_64) asset=omp-darwin-x64 ;;
    *) fastup_resolve_error omp "unsupported architecture $(uname -m)"; return 1 ;;
  esac
  api="${FASTUP_OMP_API:-https://api.github.com/repos/can1357/oh-my-pi/releases/latest}"
  api_host="${api#*://}"
  api_host="${api_host%%/*}"
  api_host="${api_host%%:*}"
  # gh may be installed but logged out; fall through to curl then.
  if [ "$api_host" = api.github.com ] && command -v gh >/dev/null 2>&1 &&
    metadata="$(gh api repos/can1357/oh-my-pi/releases/latest 2>/dev/null)"; then :
  elif [ "$api_host" = api.github.com ] && [ -n "${GITHUB_TOKEN:-}" ]; then
    metadata="$(curl -fsSL -H "Authorization: Bearer $GITHUB_TOKEN" "$api")" || { fastup_resolve_error omp 'cannot fetch official release metadata'; return 1; }
  else
    metadata="$(curl -fsSL "$api")" || { fastup_resolve_error omp 'cannot fetch official release metadata'; return 1; }
  fi
  tag="$(printf '%s' "$metadata" | /usr/bin/plutil -extract tag_name raw -o - - 2>/dev/null)" || { fastup_resolve_error omp 'official release metadata has no tag'; return 1; }
  index=0
  digest=; url=
  while :; do
    name="$(printf '%s' "$metadata" | /usr/bin/plutil -extract "assets.$index.name" raw -o - - 2>/dev/null)" || break
    if [ "$name" = "$asset" ]; then
      digest="$(printf '%s' "$metadata" | /usr/bin/plutil -extract "assets.$index.digest" raw -o - - 2>/dev/null)" || { fastup_resolve_error omp "asset $asset has no checksum"; return 1; }
      url="$(printf '%s' "$metadata" | /usr/bin/plutil -extract "assets.$index.browser_download_url" raw -o - - 2>/dev/null)" || { fastup_resolve_error omp "asset $asset has no download URL"; return 1; }
      break
    fi
    index=$((index + 1))
  done
  case "${digest:-}" in sha256:*) digest="${digest#sha256:}" ;; *) fastup_resolve_error omp "release ${tag:-unknown} has no checksum for $asset"; return 1 ;; esac
  [ -n "${url:-}" ] || { fastup_resolve_error omp "release ${tag:-unknown} has no asset $asset"; return 1; }
  LATEST="${tag#v}"
  CANDIDATES="$(gh_candidates "$url" sha256 "$digest" raw)" || { fastup_resolve_error omp "cannot build candidates for $asset"; return 1; }
}

agy_detect() { fastup_native_detect agy; }

agy_current() {
